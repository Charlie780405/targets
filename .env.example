# 复制为 .env（.env 已被 gitignore，绝不入库）
# Vultr amd64 部署：cp .env.example .env 后按需填写密钥

# --- 数据库 ---
# systemd / 本机绝对路径（推荐生产）
DATABASE_URL=sqlite:////home/dev/Targets/data/target_intel.sqlite
# 相对路径（仅在仓库根目录手动运行时）
# DATABASE_URL=sqlite:///data/target_intel.sqlite
# 云端正式：PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/target_intel

# --- Vault（Obsidian 同步）---
VAULT_PATH=/home/dev/Targets/vault
# 私有 Vault 仓库 — 必须用 SSH URL（Vultr 上 HTTPS 无法交互登录）
VAULT_GIT_REMOTE=git@github.com:Charlie780405/target-intel-vault.git
VAULT_GIT_USER_NAME=target-intelligence
VAULT_GIT_USER_EMAIL=Charlie780405@outlook.com

# --- NCBI E-utilities（PubMed）---
NCBI_API_KEY=
NCBI_TOOL=target-intelligence
NCBI_EMAIL=Charlie780405@outlook.com

# --- LLM（结构化抽取 / 摘要）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 有 OPENAI_API_KEY 时默认启用 LLM；显式关闭：PUBLISH_USE_LLM=false
PUBLISH_USE_LLM=true

# --- 采集礼貌策略 ---
HTTP_USER_AGENT="target-intelligence/0.1 (+https://targets.qyunsgen.com)"
HTTP_MAX_RPS=3

# --- 健康检查 / Docker ---
SERVICE_NAME=target-intelligence

# --- WeKnora 文献证据同步（默认关闭）---
# 开启前确认 Targets API Key 仅由 owner-only 文件或秘密环境变量提供。
WEKNORA_SYNC_ENABLED=false
WEKNORA_BASE_URL=https://weknora.qyunsgen.com
WEKNORA_TARGETS_KB_ID=
# 相对路径按仓库根目录解析；文件必须是 0600。留空则改用环境变量。
WEKNORA_TARGETS_API_KEY_FILE=secrets/weknora-targets-retrieve.key
# 使用环境变量时，将上一项留空，并配置此变量名及对应密钥。
WEKNORA_TARGETS_API_KEY_ENV=WEKNORA_TARGETS_API_KEY
WEKNORA_SYNC_HOUR=7
WEKNORA_SYNC_MINUTE=0

# --- WeKnora Targets 浏览器工作台（默认关闭，仅回环/内网使用）---
# 开启前必须配置限定 KB 和单独的临时/秘密审核令牌；不要提交真实令牌。
TARGETS_REVIEW_UI_ENABLED=false
TARGETS_REVIEW_UI_KB_ID=
TARGETS_REVIEW_UI_TOKEN=

# --- 告警（001f 预留，尚未接线）---
SENTRY_DSN=
ALERT_EMAIL_TO=
